{
  "name": "python-mineflayer-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Python-controlled Mineflayer bot with prismarine-viewer",
  "main": "bridge/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env bridge/index.js",
